@page "/personal/psl.html"
@{
    ViewData["Title"] = "Phigros Score Lookup Online - yt6983138";
    ViewData["ActiveTab"] = "Tools";

    Layout = "_Layout";
}

@section Headers {
    <style>
        .draggable {
            position: absolute;
            width: fit-content;
            height: fit-content;
        }

            .draggable > .dialog-header {
                cursor: grab;
                touch-action: none;
            }

        main {
            height: 100vh;
            width: 100vw;
        }
        select {
            margin-top: 5px;
            margin-bottom: 5px;
        }

        #main {
            max-width: 32em;
        }
        #main > .dialog-body {
            padding: 16px;
        }

        #LoginGroup {
            margin-top: 20px;
        }
        #MiscControls {
            margin-top: 5px;
        }
        #Progress {
            margin-top: 10px;
        }
        #ProgressBar {
            transform: scaleY(0.75);
        }

        #TapTapLoginInfoGroupQRCode {
            content: "";
            margin: 10px auto 10px 5px;
            padding: 6px;
            width: fit-content;
            background-color: white;
            border: 2px solid gray
        }

        #ScoreView {
            padding: 0;
        }
        #ScoreView > .dialog-header {
            margin: 0;
        }
        #ScoreView > .dialog-body {
            max-height: 90vh;
            overflow: scroll;
        }

        #AboutMe {
            margin-top: 15px;
        }
        #ScoresTable {
            margin-top: 15px;
        }
    </style>
    <script src="/swagger/PhigrosApi/PhigrosApi.bundled.js"></script>
    <script src="/personal/js/psl.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/davidshimjs/qrcodejs@gh-pages/qrcode.min.js"></script>
    <script src="https://unpkg.com/papaparse@5.5.4/papaparse.min.js"></script>
}

<win-dialog id="main" title="Begin" style="left: 20px; top: 40px">
    <h2>Phigros Score Lookup Online</h2>
    <p>
        This is a web version of <a href="https://github.com/yt6983138/PSLDiscordBot">PSLDiscordBot</a>, 
        Phigros Score Lookup Discord Bot. This page only provides basic functionalities of PSLDiscordBot, 
        please try the Discord version if you want better experience or more functionalities.<br/>
        <strong>Note: This page has poor support for mobile.</strong>
    </p>
    <h3>Instruction</h3>
    <p>
        1. Login by the buttons at bottom (Select either TapTap or Manual by token) <br />
        2. View or download your scores <br />
        3. Logout if you are using shared computer <br />
        Hint: Windows are draggable
    </p>
    <div id="LoginGroup">
        <button id="Logout" onclick="Logout(event)">Logout</button>
        <button id="LoginTapTap" onclick="LoginTapTap(event)">Login (TapTap)...</button>
        <button id="LoginManual" onclick="LoginManual(event)">Login (Manual)...</button>

        <input id="SaveToken" type="checkbox" />
        <label for="SaveToken">Save token</label><br />

        <div id="MiscControls">
            <button id="SeeMyTokenButton" onclick="SeeMyToken(event)">See My Token...</button>
            <button id="SelectIndexButton" onclick="SelectSaveIndex(event)">Select Index...</button>
        </div>
    </div>
    <div id="Progress" style="display: none">
        <label id="ProgressLabel" for="ProgressBar"></label><br/>
        <progress id="ProgressBar"></progress>
    </div>
</win-dialog>

<win-dialog id="TapTapLogin" title="TapTap Login" style="left: 40px; top: 60px; display: none; z-index: 9000">
    <h3>Login Instruction</h3>
    <p>
        1. Click the "Generate Login" button <br />
        2. Login using the QRCode or the link (For non-international accounts, <br />
            a helper website is provided for those who cannot download TapTap China) <br />
        3. Complete the login using the TapTap app/website before it times out <br />
    </p>
    <br />

    <div id="TapTapLoginInfoGroup" style="display: none">
        <div id="TapTapLoginInfoGroupQRCode"></div>
        <a id="TapTapLoginInfoGroupURL">Primary login link</a>
        <a id="TapTapLoginInfoGroupURLAlternate" style="display: none">China alternate login link</a>
        <p id="TapTapLoginInfoGroupInfo"></p>
    </div>
    
    <br />
    <input id="TapTapLoginIsInternational" type="checkbox" />
    <label for="TapTapLoginIsInternational">International Account</label> <br />
    <button id="TapTapLoginGenerate" onclick="LoginTapTapGenerate(event)">Generate Login</button>
    <button id="TapTapLoginCancel" onclick="LoginTapTapCancel(event)">Cancel</button>
</win-dialog>

<win-dialog id="ManualLogin" title="Manual Login" style="left: 40px; top: 60px; display: none; z-index: 9000">
    <label for="ManualLoginToken">Please enter your token.</label>
    <input id="ManualLoginToken" type="text" maxlength="25" /> <br />

    <input id="ManualLoginIsInternational" type="checkbox" />
    <label for="ManualLoginIsInternational">International Account</label> <br />

    <p id="ManualLoginError" style="color: red"></p> <br />

    <button id="ManualLoginCheck" onclick="LoginManualNext(event)">Enter</button>
    <button id="ManualLoginCancel" onclick="LoginManualCancel(event)">Cancel</button>
</win-dialog>

<win-dialog id="SeeMyToken" title="Token" style="left: 60px; top: 80px; display: none; z-index: 9000">
    <p id="SeeMyTokenContent"></p><br/>
    <button onclick="SeeMyTokenClose(event)">Close</button>
</win-dialog>

<win-dialog id="SelectIndex" title="Select save index" style="left: 80px; top: 100px; display: none; z-index: 9000">
    <label for="SelectIndexMenu">Select index below: (0 is always latest)</label><br/>
    <select id="SelectIndexMenu">
    </select><br/>
    <button id="SelectIndexButton" onclick="SelectSaveIndexClose(event)">Close</button>
</win-dialog>

<win-dialog id="ScoreView" title="Scores" style="left: 80px; top: 200px; display: none; z-index: 9000">
    <button id="DownloadScoreCSV" onclick="DownloadCSV(event)">Download Score As CSV</button>
    <button id="DownloadJSON" onclick="DownloadJSON(event)">Download Everything As JSON</button>
    <input type="checkbox" id="DownloadBOM" />
    <label for="DownloadBOM">With UTF-8 BOM (check this for compatibility)</label>

    <table id="AboutMe">
        <tr class="TableTitle">
            <th class="TableTitleTexts TableFirst">Avatar</th>
            <th class="TableTitleTexts TableSecond">Nickname</th>
            <th class="TableTitleTexts TableThird">Last Modified At</th>
            <th class="TableTitleTexts TableForth">Challenge Rank</th>
            <th class="TableTitleTexts TableFifth">Total RKS</th>
        </tr>
        <tr id="AboutMeData">

        </tr>
    </table>

    <table id="ScoresTable">
        <tr class="TableTitle">
            <th class="TableTitleTexts TableFirst">Number</th>
            <th class="TableTitleTexts TableSecond">Song Name</th>
            <th class="TableTitleTexts TableThird">Difficulty</th>
            <th class="TableTitleTexts TableForth">Score</th>
            <th class="TableTitleTexts TableFifth">Accuracy</th>
            <th class="TableTitleTexts TableSixth">RKS</th>
            <th class="TableTitleTexts TableSeventh">Status</th>
        </tr>
    </table>
</win-dialog>
