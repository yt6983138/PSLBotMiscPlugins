<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\PSLDiscordBotBase\PSLDiscordBot.Framework\PSLDiscordBot.Framework.csproj" Private="false" />
		<ProjectReference Include="..\PhigrosApi.Client.Javascript\PhigrosApi.Client.Javascript.esproj" />

		<ProjectReference Condition="'$(Configuration)' == 'Debug'" Include="..\PhigrosApi\PhigrosApi.csproj" Private="false" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="Blogs\**" Condition="'$(Configuration)' == 'Release'">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<!-- Copied to the server by hand; never part of a deploy. -->
		<Content Update="Blogs\**">
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\swagger\PhigrosApi\" />
	</ItemGroup>

	<Target Name="CopyClient" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
		<Copy SourceFolders="../PhigrosApi.Client.Javascript/out/" DestinationFolder="./wwwroot/swagger/PhigrosApi/"></Copy>
	</Target>
	<Target Name="CleanUp" BeforeTargets="Clean">
		<RemoveDir Directories="./wwwroot/swagger/"></RemoveDir>
	</Target>
</Project>
